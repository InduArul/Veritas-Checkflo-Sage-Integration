# /etc/intacct-etl/intacct-etl.env  — SECRETS ONLY (never commit; chmod 600, root:intacct)
# Loaded by systemd (EnvironmentFile) or `set -a; source intacct-etl.env; set +a` for manual runs.
#
# Sage credentials are resolved per environment using the pattern  {sage_creds_key}_{FIELD}
# from config.yaml (environments[].sage_creds_key + sage.secret_key_pattern).
# For environments[].sage_creds_key = "Prod_Sage_Evergreen":

Prod_Sage_Evergreen_SENDER_ID=your_sender_id
Prod_Sage_Evergreen_SENDER_PASSWORD=your_sender_password
Prod_Sage_Evergreen_USER_ID=your_web_services_user
Prod_Sage_Evergreen_USER_PASSWORD=your_web_services_password
Prod_Sage_Evergreen_COMPANY_ID=your_company_id

# Add a block per additional environment, e.g. Prod_Sage_Westwind_SENDER_ID=... etc.

# SQL Server password (key = sql.password_secret_key in config.yaml; default SQL_PASSWORD).
# Only needed when sql.auth_mode = sql.
SQL_PASSWORD=your_sql_password
